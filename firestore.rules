rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CAMBIA este correo por el de la administradora (debe ser una cuenta verificada, p. ej. Google)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['cesamendoza19@gmail.com', 'araceltruji1984@gmail.com'];
    }

    // La clienta responde desde el enlace que recibe por WhatsApp (cita.html?id=...).
    // Solo puede confirmar o cancelar una cita que siga activa, y solo toca 'estado' y 'respuesta'.
    function clientaResponde() {
      let nueva = request.resource.data;
      return resource.data.estado in ['pendiente', 'confirmada']
        && nueva.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuesta'])
        && ((nueva.estado == 'confirmada' && nueva.respuesta == 'confirmo')
         || (nueva.estado == 'cancelada' && nueva.respuesta == 'cancelo'));
    }

    // Citas: cualquiera puede crear una (sin cuenta). La lista solo la ve la admin.
    // Una cita suelta se puede abrir con su id (20 caracteres al azar, imposible de adivinar):
    // ese id solo viaja en el enlace que la admin manda por WhatsApp a la clienta.
    match /appointments/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.estado == 'pendiente'
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 60
        && request.resource.data.telefono.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['nombre','telefono','servicio','notas','fecha','hora','slotId','estado','creada']);
      allow update: if isAdmin() || clientaResponde();
      allow delete: if isAdmin();
    }

    // Clientas que confirmaron (para promociones). Solo las administradoras las ven y editan.
    match /contactos/{tel} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && tel.matches('^[0-9]{10}$')
        && request.resource.data.telefono == tel;
    }

    // Horarios ocupados: solo fecha/hora, sin datos personales. Un horario no se puede reservar dos veces
    // (el id es fijo y no se permite update, así el segundo intento falla).
    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['fecha','hora'])
        && slotId == request.resource.data.fecha + '_' + request.resource.data.hora.replace(':', '');
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Rastreo. Las dos admins ESCRIBEN su ubicación, pero solo cesamendoza19 puede LEER el rastreo.
    function ubicacionValida(d) {
      return d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.precision is number && d.precision >= 0;
    }
    // Quién puede VER el rastreo (leer ubicación, historial y recorrido). Solo este correo, nadie más.
    function puedeVerRastreo() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'cesamendoza19@gmail.com';
    }
    // Última ubicación conocida: un documento por correo, se va sobrescribiendo.
    match /ubicacion/{correo} {
      allow read: if puedeVerRastreo();
      allow create, update: if isAdmin()
        && correo == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email','lat','lng','precision','actualizada','dispositivo'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.actualizada == request.time
        && ubicacionValida(request.resource.data);
      allow delete: if false;
    }
    // Historial: una fila cada vez que se abre el panel (con o sin ubicación).
    match /accesos/{id} {
      allow read: if puedeVerRastreo();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email','lat','lng','precision','creada','dispositivo','motivo'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.creada == request.time
        && (request.resource.data.lat == null || ubicacionValida(request.resource.data));
      allow update: if false;
      allow delete: if puedeVerRastreo();
    }
    // Recorrido: un punto por minuto mientras el panel está abierto (se dibuja como ruta en el mapa).
    match /rastro/{id} {
      allow read: if puedeVerRastreo();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email','lat','lng','precision','creada','dispositivo'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.creada == request.time
        && ubicacionValida(request.resource.data);
      allow update: if false;
      allow delete: if puedeVerRastreo();
    }
  }
}
